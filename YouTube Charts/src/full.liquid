{% assign chart = tracksWeekly | default: tracksDaily %}
<div class="layout layout--col layout--top">
  {% if chart and chart.trackViews %}
    <div class="flex flex--row" style="justify-content: space-between; margin-bottom: 6px;">
      <span class="label">{{ countryCode | upcase }}</span>
      <span class="label">Week Ending {{ chart.endDate | default: "-" }}</span>
    </div>

    <div class="flex flex--row" style="gap: 8px; width: 100%;">
      <div class="flex flex--col" style="flex: 1;">
        {% for track in chart.trackViews limit: 5 %}
          <div class="item">
            <div class="meta"><span class="index">{{ track.currentPosition | default: forloop.index }}</span></div>
            <div class="icon">
              {% if track.thumbnailUrl %}
                <img class="image image--xsmall image--cover image-dither" src="{{ track.thumbnailUrl }}">
              {% endif %}
            </div>
            <div class="content">
              <span class="title title--small">{{ track.title | default: "Unknown" | truncate: 26 }}</span>
              <span class="description">{{ track.artists | default: "Unknown" | truncate: 34 }}</span>
              <div class="flex gap--small">
                <span class="label label--small label--underline">{{ track.viewCount | default: "-" }} views</span>
                <span class="label label--small label--underline">{{ track.percentViewsChange | default: "-" }}</span>
              </div>
            </div>
          </div>
        {% endfor %}
      </div>

      <div class="flex flex--col" style="flex: 1;">
        {% for track in chart.trackViews offset: 5 limit: 5 %}
          <div class="item">
            <div class="meta"><span class="index">{{ track.currentPosition | default: forloop.index | plus: 5 }}</span></div>
            <div class="icon">
              {% if track.thumbnailUrl %}
                <img class="image image--xsmall image--cover image-dither" src="{{ track.thumbnailUrl }}">
              {% endif %}
            </div>
            <div class="content">
              <span class="title title--small">{{ track.title | default: "Unknown" | truncate: 26 }}</span>
              <span class="description">{{ track.artists | default: "Unknown" | truncate: 34 }}</span>
              <div class="flex gap--small">
                <span class="label label--small label--underline">{{ track.viewCount | default: "-" }} views</span>
                <span class="label label--small label--underline">{{ track.percentViewsChange | default: "-" }}</span>
              </div>
            </div>
          </div>
        {% endfor %}
      </div>
    </div>
  {% else %}
    <div class="layout layout--col layout--center">
      <span class="value value--small">No weekly chart data available.</span>
      <span class="label">Try another country in plugin settings.</span>
    </div>
  {% endif %}
</div>

<div class="title_bar">
  <img class="image image--adaptive" src="https://trmnl.com/images/plugins/trmnl--render.svg">
  <span class="title">{{ trmnl.plugin_settings.instance_name }}</span>
  <span class="instance">Updated {{ lastUpdatedLocalTime | date: "%b %d, %I:%M %p" }}</span>
</div>
