{% assign top_chart = videosDaily | default: videosWeekly %}
{% assign top_chart_period = top_chart.chartPeriodType | downcase %}
{% assign trending_chart = videosTrending %}
<div class="layout layout--col layout--top">
  {% if top_chart and top_chart.videoViews %}
    {% if trending_chart and trending_chart.videoViews %}
      <div class="flex flex--row portrait:flex--col" style="gap: 10px; width: 100%;">
        <div class="flex flex--col" style="flex: 1;">
          <span class="label lg:label--large" style="margin-bottom: 6px;">
            {% if top_chart_period contains "daily" %}
              Daily Top Music Videos
            {% elsif top_chart_period contains "weekly" %}
              Weekly Top Music Videos
            {% else %}
              Top Music Videos
            {% endif %}
          </span>
          <div class="flex flex--col" data-overflow="true">
            {% for video in top_chart.videoViews %}
              <div class="item" style="margin-bottom: 10px;">
                <div class="icon" style="width: 96px; min-width: 96px; align-self: stretch;">
                  {% if video.thumbnailUrl %}
                    <img class="image image--cover image-dither" style="width: 100%; height: 100%;" src="{{ video.thumbnailUrl }}">
                  {% endif %}
                </div>
                <div class="content">
                  <span class="title">{{ video.title | default: "Unknown" | truncate: 24 }}</span>
                  <span class="description description--large">{{ video.artists | default: "Unknown" | truncate: 32 }}</span>
                  <div class="flex gap--small">
                    <span class="label">{{ video.viewCount | default: "-" }} views</span>
                    <span class="label">{{ video.percentViewsChange | default: "-" }}</span>
                  </div>
                </div>
              </div>
            {% endfor %}
          </div>
        </div>

        <div class="flex flex--col" style="flex: 1;">
          <span class="label lg:label--large" style="margin-bottom: 6px;">Trending Music Videos</span>
          <div class="flex flex--col" data-overflow="true">
            {% for video in trending_chart.videoViews %}
              <div class="item" style="margin-bottom: 10px;">
                <div class="icon" style="width: 96px; min-width: 96px; align-self: stretch;">
                  {% if video.thumbnailUrl %}
                    <img class="image image--cover image-dither" style="width: 100%; height: 100%;" src="{{ video.thumbnailUrl }}">
                  {% endif %}
                </div>
                <div class="content">
                  <span class="title">{{ video.title | default: "Unknown" | truncate: 24 }}</span>
                  <span class="description description--large">{{ video.artists | default: "Unknown" | truncate: 32 }}</span>
                  <div class="flex gap--small">
                    <span class="label">{{ video.viewCount | default: "-" }} views</span>
                    <span class="label">{{ video.percentViewsChange | default: "-" }}</span>
                  </div>
                </div>
              </div>
            {% endfor %}
          </div>
        </div>
      </div>
    {% else %}
      <span class="label" style="margin-bottom: 6px; display: block; text-align: center; width: 100%;">
        {% if top_chart_period contains "daily" %}
          Daily Top Music Videos
        {% elsif top_chart_period contains "weekly" %}
          Weekly Top Music Videos
        {% else %}
          Top Music Videos
        {% endif %}
      </span>
      <div class="columns" data-overflow-max-cols="2" data-overflow-max-cols-portrait="1" style="column-gap: 10px;">
        <div class="column">
          {% for video in top_chart.videoViews %}
            <div class="item" style="margin-bottom: 10px;">
              <div class="icon" style="width: 96px; min-width: 96px; align-self: stretch;">
                {% if video.thumbnailUrl %}
                  <img class="image image--cover image-dither" style="width: 100%; height: 100%;" src="{{ video.thumbnailUrl }}">
                {% endif %}
              </div>
              <div class="content">
                <span class="title">{{ video.title | default: "Unknown" | truncate: 28 }}</span>
                <span class="description description--large">{{ video.artists | default: "Unknown" | truncate: 36 }}</span>
                <div class="flex gap--small">
                  <span class="label">{{ video.viewCount | default: "-" }} views</span>
                  <span class="label">{{ video.percentViewsChange | default: "-" }}</span>
                </div>
              </div>
            </div>
          {% endfor %}
        </div>
      </div>
    {% endif %}
  {% else %}
    <div class="layout layout--col layout--center">
      <span class="value value--small">No top video chart data available.</span>
      <span class="label">Try another country in plugin settings.</span>
    </div>
  {% endif %}
</div>

<div class="title_bar">
  <img class="image image--adaptive" src="https://trmnl.com/images/plugins/trmnl--render.svg">
  <span class="title">{{ trmnl.plugin_settings.instance_name }} • {{ country.name | default: "Global" }}</span>
  <span class="instance">{{ lastUpdatedLocalTime | date: "%b %d, %I:%M %p" }}</span>
</div>
