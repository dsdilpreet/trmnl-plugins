{% assign chart = trackTypes[0] %}
<div class="layout layout--col layout--top">
  {% if chart and chart.topTracks %}
    <div class="label" style="margin-bottom: 6px;">{{ countryCode | upcase }} • {{ chart.endDate | default: "-" }}</div>

    {% for track in chart.topTracks limit: 4 %}
      <div class="item">
        <div class="meta"><span class="index">{{ track.currentPosition | default: forloop.index }}</span></div>
        <div class="icon">
          {% if track.thumbnailUrl %}
            <img class="image image--xsmall image--cover image-dither" src="{{ track.thumbnailUrl }}">
          {% endif %}
        </div>
        <div class="content">
          <span class="title title--small">{{ track.title | default: "Unknown" | truncate: 22 }}</span>
          <span class="description">{{ track.artists | default: "Unknown" | truncate: 24 }}</span>
          <span class="label label--small">{{ track.viewCount | default: "-" }} views</span>
        </div>
      </div>
    {% endfor %}
  {% else %}
    <div class="layout layout--col layout--center">
      <span class="value value--small">No chart data available.</span>
    </div>
  {% endif %}
</div>

<div class="title_bar">
  <img class="image image--adaptive" src="https://trmnl.com/images/plugins/trmnl--render.svg">
  <span class="title">{{ trmnl.plugin_settings.instance_name }}</span>
  <span class="instance">Updated {{ lastUpdatedLocalTime | date: "%b %d, %I:%M %p" }}</span>
</div>
