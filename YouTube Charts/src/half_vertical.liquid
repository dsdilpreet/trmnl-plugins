{% assign chart = videosDaily | default: videosWeekly %}
{% assign chart_period = chart.chartPeriodType | downcase %}
<div class="layout layout--col layout--top">
  {% if chart and chart.videoViews %}
    <div class="label lg:label--large" style="margin-bottom: 6px;">
      {% if chart_period contains "daily" %}
        Daily Top Music Videos
      {% elsif chart_period contains "weekly" %}
        Weekly Top Music Videos
      {% else %}
        Top Music Videos
      {% endif %}
    </div>
    <div class="flex flex--col" data-overflow="true">
      {% for video in chart.videoViews %}
        <div class="item" style="margin-bottom: 10px;">
          <div class="icon" style="width: 96px; min-width: 96px; align-self: stretch;">
            {% if video.thumbnailUrl %}
              <img class="image image--cover image-dither" style="width: 100%; height: 100%;" src="{{ video.thumbnailUrl }}">
            {% endif %}
          </div>
          <div class="content">
            <span class="title">{{ video.title | default: "Unknown" | truncate: 24 }}</span>
            <span class="description description--large">{{ video.artists | default: "Unknown" | truncate: 30 }}</span>
            <div class="flex gap--small">
              <span class="label">{{ video.viewCount | default: "-" }} views</span>
              <span class="label">{{ video.percentViewsChange | default: "-" }}</span>
            </div>
          </div>
        </div>
      {% endfor %}
    </div>
  {% else %}
    <div class="layout layout--col layout--center">
      <span class="value value--small">No chart data available.</span>
    </div>
  {% endif %}
</div>

<div class="title_bar">
  <img class="image image--adaptive" src="https://trmnl.com/images/plugins/trmnl--render.svg">
  <span class="title">{{ trmnl.plugin_settings.instance_name }} • {{ country.name | default: "Global" }}</span>
  <span class="instance">{{ lastUpdatedLocalTime | date: "%b %d, %I:%M %p" }}</span>
</div>
