{% assign chart = videosDaily | default: videosWeekly %}
<div class="layout layout--col layout--top">
  {% if chart and chart.videoViews %}
    <div class="label" style="margin-bottom: 4px;">Top Music Videos</div>

    {% for video in chart.videoViews limit: 4 %}
      <div class="item">
        <div class="meta"><span class="index">{{ video.currentPosition | default: forloop.index }}</span></div>
        <div class="icon">
          {% if video.thumbnailUrl %}
            <img class="image image--xsmall image--cover image-dither" src="{{ video.thumbnailUrl }}">
          {% endif %}
        </div>
        <div class="content">
          <span class="title title--small">{{ video.title | default: "Unknown" | truncate: 22 }}</span>
          <span class="description">{{ video.artists | default: "Unknown" | truncate: 24 }}</span>
          <span class="label label--small">{{ video.viewCount | default: "-" }} views</span>
        </div>
      </div>
    {% endfor %}
  {% else %}
    <div class="layout layout--col layout--center">
      <span class="value value--small">No chart data available.</span>
    </div>
  {% endif %}
</div>

<div class="title_bar">
  <img class="image image--adaptive" src="https://trmnl.com/images/plugins/trmnl--render.svg">
  <span class="title">{{ trmnl.plugin_settings.instance_name }} • {{ country.name | default: "Global" }}</span>
  <span class="instance">{{ lastUpdatedLocalTime | date: "%b %d, %I:%M %p" }}</span>
</div>
